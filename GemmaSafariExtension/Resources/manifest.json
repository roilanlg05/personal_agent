{
  "manifest_version": 3,
  "name": "Gemma Extension",
  "version": "1.3.1",
  "description": "Sincroniza autom\u00e1ticamente tu sesi\u00f3n de Amazon A to Z con Gemma",
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.amazon.work/*",
    "http://100.91.174.81:8081/*",
    "http://localhost:8081/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemma A to Z Sync",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.work/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
